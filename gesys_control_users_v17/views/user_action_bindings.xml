<odoo>
    <!-- Ver Acciones: binding para abrir acciones del registro actual -->
    <record id="action_view_actions_account_move" model="ir.actions.act_window">
        <field name="name">Ver Acciones</field>
        <field name="res_model">gesys_control.user_action</field>
        <field name="view_mode">tree,form</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
        <field name="domain">[('model_name','=','account.move'),('record_id','=',active_id)]</field>
