<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_action_line_tree" model="ir.ui.view">
        <field name="name">gesys_control.user_action_line.tree</field>
        <field name="model">gesys_control.user_action_line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Change Lines" create="0" edit="0" delete="0">
                <field name="action_date"/>
                <field name="user_id"/>
                <field name="user_action_id"/>
                <field name="field_name"/>
                <field name="old_value_text"/>
                <field name="new_value_text"/>
            </list>
        </field>
    </record>
    <record id="view_user_action_line_search" model="ir.ui.view">
        <field name="name">gesys_control.user_action_line.search</field>
        <field name="model">gesys_control.user_action_line</field>
        <field name="arch" type="xml">
            <search string="Lines">
                <field name="field_name"/>
                <field name="user_id"/>
                <field name="user_action_id"/>
                <field name="action_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_field" string="Field" context="{'group_by': 'field_name'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_user_action_line" model="ir.actions.act_window">
        <field name="name">Change Lines</field>
        <field name="res_model">gesys_control.user_action_line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_user_action_line_tree"/>
        <field name="search_view_id" ref="view_user_action_line_search"/>
    </record>
</odoo>
