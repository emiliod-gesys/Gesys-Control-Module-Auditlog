<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job para limpieza automática de registros -->
        <record id="ir_cron_cleanup_old_actions" model="ir.cron">
            <field name="name">Control: Limpieza Automática de Acciones Antiguas</field>
            <field name="model_id" ref="model_gesys_control_config"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_records()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>