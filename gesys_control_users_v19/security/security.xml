<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Category -->
        <record id="module_category_gesys_control" model="ir.module.category">
            <field name="name">Control</field>
            <field name="description">User Control Module</field>
            <field name="sequence">100</field>
        </record>
        
        <!-- User Group (Odoo 19: category_id removed from res.groups) -->
        <record id="group_gesys_control_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Administrator Group -->
        <record id="group_gesys_control_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_gesys_control_user'))]"/>
        </record>
    </data>
</odoo>