<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_action_rule_form" model="ir.ui.view">
        <field name="name">gesys_control.rule.form</field>
        <field name="model">gesys_control.rule</field>
        <field name="arch" type="xml">
            <form string="Audit Rule">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="active"/>
                        <field name="users_to_exclude_ids" widget="many2many_tags"/>
                        <field name="fields_to_exclude_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_user_action_rule_tree" model="ir.ui.view">
        <field name="name">gesys_control.rule.tree</field>
        <field name="model">gesys_control.rule</field>
        <field name="arch" type="xml">
            <list string="Rules">
                <field name="model_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_user_action_rule" model="ir.actions.act_window">
        <field name="name">Audit Rules</field>
        <field name="res_model">gesys_control.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
